# ค่าสำหรับรันด้วย Docker — copy เป็น .env.docker แล้วแก้ทุกค่าที่เป็น CHANGE_ME
# (ไฟล์ .env.docker ไม่ถูกใส่ใน image และไม่ควรแชร์)

# ---- ฐานข้อมูลของระบบ (container "db") ----
# APP_DB_PASSWORD กับ MYSQL_PASSWORD ต้องเป็นค่าเดียวกัน
APP_DB_USER=hisreport
APP_DB_PASSWORD=CHANGE_ME
APP_DB_NAME=hisreport_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# ---- ฐาน HIS (อ่านอย่างเดียว) ----
HIS_DB_HOST=10.0.0.8
HIS_DB_PORT=3306
HIS_DB_USER=hiuser
HIS_DB_PASSWORD=CHANGE_ME
HIS_DB_NAME=hi
HIS_LEGACY_SCHEMA=reportdb
HIS_MAX_CONCURRENT=2

# ---- ระบบ ----
# สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
HOSPITAL_NAME=โรงพยาบาลศรีเมืองใหม่

SAVED_MAX_FILES=50
SAVED_MAX_MB=200
