# ฐานข้อมูลของระบบรายงาน (MySQL 8 บนเครื่องนี้) — ดู db/00_create_db_and_user.sql
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=hisreport
APP_DB_PASSWORD=
APP_DB_NAME=hisreport_app

# ฐานข้อมูล HIS (อ่านอย่างเดียว)
HIS_DB_HOST=10.0.0.8
HIS_DB_PORT=3306
HIS_DB_USER=hiuser
HIS_DB_PASSWORD=
HIS_DB_NAME=hi
# จำนวนรายงานที่คิวรี่ HIS พร้อมกันได้ (รวมทุกผู้ใช้) — ที่เหลือรอคิว
HIS_MAX_CONCURRENT=2

# แฟ้มผลรายงานที่ผู้ใช้บันทึกไว้: จำนวนแฟ้ม / พื้นที่ (MB หลังบีบอัด) ต่อผู้ใช้
SAVED_MAX_FILES=50
SAVED_MAX_MB=200
# schema ที่เก็บคิวรี่เดิม (rep_query_item)
HIS_LEGACY_SCHEMA=reportdb

# คีย์เซ็นคุกกี้ session (สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร)
SESSION_SECRET=

# ผู้ดูแลระบบเริ่มต้น (บัญชี local ใช้ระหว่างรอ login ด้วยบัญชี HIS)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

HOSPITAL_NAME=โรงพยาบาลศรีเมืองใหม่
